+            var result = EmberExtensionCatalog.Resolve(_prepared, _requested);
+            if (_batchDepth > 0) _batchResolution = result;
+            return result;
+        }
+        #endregion
+        // --------------------------------------------------------
+        #region 外部方法
+        /// <summary>同步只读检查批次。不要跨帧持有；动态模块条件仍按调用实时求值。</summary>
+        public static IDisposable BeginCheckBatch()
+        {
