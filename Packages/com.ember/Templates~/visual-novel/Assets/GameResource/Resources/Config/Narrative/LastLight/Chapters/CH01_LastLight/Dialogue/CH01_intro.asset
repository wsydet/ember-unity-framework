    _lineId: last_light_line_intro_001
    _textRevision: 2
    _characterId: 
    _text: "\u5929\u53F0\u7684\u95E8\u5728\u8EAB\u540E\u5408\u4E0A\u3002\u96E8\u540E\u7684\u680F\u6746\u8FD8\u7559\u7740\u6C34\u73E0\uFF0C\u8FDC\u5904\u4E00\u6392\u7A97\u6237\u9010\u6E10\u4EAE\u8D77\u6765\u3002\u6797\u665A\u7AD9\u5728\u6700\u540E\u4E00\u675F\u5915\u5149\u91CC\uFF0C\u6000\u4E2D\u62B1\u7740\u4E00\u4E2A\u6CA1\u6709\u7F72\u540D\u7684\u4FE1\u5C01\u3002"
    _resourceKey: 
    _variableId: 
    _scope: 0
    _value:
      _type: 0
      _bool: 0
      _int: 0
      _string: 
    _duration: 0
    _slot: 0
    _visualAction: 0
  - _commandId: last_light_intro_002
    _kind: 0
    _lineId: last_light_line_intro_002
    _textRevision: 2
    _characterId: lastlight_inner
    _text: "\uFF08\u6211\u4EE5\u4E3A\u5979\u7EA6\u6211\u4E0A\u6765\uFF0C\u53EA\u662F\u4E3A\u4E86\u770B\u6700\u540E\u4E00\u6B21\u65E5\u843D\u3002\u76F4\u5230\u770B\u89C1\u4FE1\u5C01\u4E0A\u719F\u6089\u7684\u5B57\uFF0C\u6211\u624D\u660E\u767D\uFF0C\u6709\u4E9B\u544A\u522B\u4ECE\u6765\u6CA1\u6709\u771F\u6B63\u8BF4\u5B8C\u3002\uFF09"
