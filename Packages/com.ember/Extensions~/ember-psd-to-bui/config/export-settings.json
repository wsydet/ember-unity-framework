{
  "plugin": "ember-psd-to-bui",
  "version": "1.0.0",
  "schemaPathHint": "protocol/bui.v3.schema.json",
  "output": {
    "buiExtension": ".bui",
    "assetsSuffix": "_bui_assets",
    "sliceFileNamePrefix": "UI_"
